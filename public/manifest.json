{
  "manifest_version": 3,
  "name": "LocalREST \u2014 API Client for REST, cURL & Postman",
  "version": "1.0.0",
  "description": "Build, send and organise HTTP requests entirely in your browser. No account, no cloud sync, no 200MB desktop app.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open LocalREST"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
